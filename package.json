{
  "name": "gsu-postgraduate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:vinext": "vite dev --port 3001",
    "build": "vite build",
    "build:next": "next build",
    "start": "next start",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json --persist-to .wrangler/state",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:seed:generate": "node scripts/seed.mjs",
    "db:migrate:local": "wrangler d1 execute gsu-postgraduate --local --file drizzle/migrations/0000_dapper_blonde_phantom.sql && wrangler d1 execute gsu-postgraduate --local --file drizzle/migrations/0001_open_morgan_stark.sql",
    "db:migrate:remote": "wrangler d1 execute gsu-postgraduate --remote --file drizzle/migrations/0000_dapper_blonde_phantom.sql && wrangler d1 execute gsu-postgraduate --remote --file drizzle/migrations/0001_open_morgan_stark.sql",
    "db:seed:local": "node scripts/seed.mjs && wrangler d1 execute gsu-postgraduate --local --file drizzle/seed.sql",
    "db:seed:remote": "node scripts/seed.mjs && wrangler d1 execute gsu-postgraduate --remote --file drizzle/seed.sql",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@vinext/cloudflare": "^1.0.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.47.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/workers-types": "^5.20261006.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.35",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "react-server-dom-webpack": "^19.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vinext": "^1.0.1",
    "vite": "^8.3.3",
    "wrangler": "^4.147.0"
  },
  "type": "module"
}
