# --- Database (SQLite file) ---
# Path to the SQLite database file. Defaults to ./data/lms.db
DATABASE_PATH="./data/lms.db"

# --- Media storage (local disk) ---
# Directory where uploaded files are stored. Defaults to ./data/media
MEDIA_DIR="./data/media"

# Secret used to sign session JWTs (generate with: openssl rand -base64 32)
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Public app URL (used for building absolute URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend (transactional email). Verify a sending domain in Resend and set
# EMAIL_FROM to an address on that domain for real recipients.
RESEND_API_KEY="re_xxxxxxxxx"
EMAIL_FROM="GSU Postgraduate <no-reply@postgrad.galmudugsu.edu.so>"
EMAIL_DOMAIN="postgrad.galmudugsu.edu.so"

# Signing secret from the Resend `email.received` webhook
RESEND_WEBHOOK_SECRET="whsec_xxxxxxxxx"
