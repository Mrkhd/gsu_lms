# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lms?schema=public"

# Secret used to sign session JWTs (generate with: openssl rand -base64 32)
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Payment provider: "mock" (default) — swap for a real provider later
PAYMENT_PROVIDER="mock"

# Public app URL (used for building absolute URLs, e.g. payment redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
