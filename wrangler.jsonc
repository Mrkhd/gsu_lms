{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gsu-postgraduate",
	"compatibility_date": "2026-10-06",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "vinext/server/fetch-handler",
	"assets": {
		"directory": "dist/client",
		"not_found_handling": "none",
		"binding": "ASSETS"
	},
	"images": {
		"binding": "IMAGES"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "gsu-postgraduate",
			"database_id": "31b1f8c3-9847-4d38-8e02-19440f3ba432",
			"migrations_dir": "drizzle/migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "gsu-postgraduate-media"
		}
	]
}